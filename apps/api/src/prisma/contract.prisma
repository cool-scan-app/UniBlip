// use prisma-8

model users {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}

model Session {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  expiresAt DateTime @map("expires_at")

  @@map("sessions")
}

model StoreAddress {
  id          String  @id
  street      String
  streetNr    Int     @map("street_nr")
  city        String
  postalCode  Int     @map("postal_code")

  @@map("store_addresses")
}

model Store {
  id          String       @id
  name        String
  addressId   String       @map("address_id")
  address     StoreAddress @relation(fields: [addressId], references: [id])
  latitude    Float
  longitude   Float

  @@map("stores")
}

