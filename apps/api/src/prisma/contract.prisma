// use prisma-8

model users {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}

model Session {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  expiresAt DateTime @map("expires_at")

  @@map("sessions")
}